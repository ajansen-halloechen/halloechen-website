# Session encryption (required, min. 32 characters)
NUXT_SESSION_PASSWORD=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=local

# Public site URL (used for invitation links)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Local file storage (optional — defaults to ./files in the project root)
# FILES_STORAGE_PATH=/data/files

# SMTP (production only — in development, setup links are logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@halloechen.org
