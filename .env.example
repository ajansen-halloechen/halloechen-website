# Session encryption (required, min. 32 characters)
NUXT_SESSION_PASSWORD=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=local

# Public site URL (invitation links, sitemap, canonical URLs)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexing control — set to "production" only on halloechen.org
NUXT_SITE_ENV=development

# Local file storage (optional — defaults to ./files in the project root)
# FILES_STORAGE_PATH=/data/files

# SMTP (read at container/runtime startup via server/utils/env.ts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=info@halloechen.org
