    "db:rollback": "drizzle-kit migrate:rollback --config ./drizzle.config.ts"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@internationalized/date": "^3.12.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.1.0",
    "@vueuse/gesture": "^2.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^8.0.11",
    "nuxt": "^4.4.4",
    "nuxt-auth-utils": "0.5.29",
    "pg": "^8.20.0",
    "reka-ui": "^2.9.7",
    "sharp": "^0.35.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "zod": "^4.4.3"
