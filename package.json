{
  "name": "halloechen-website",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --fix",
    "format": "prettier --config .prettierrc --write \"**/*.{ts,vue,md,yml,yaml}\"",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
