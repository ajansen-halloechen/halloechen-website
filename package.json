    "@vue/language-core": "^3.2.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.8.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.2.8"
  }
